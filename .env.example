# --- Application -------------------------------------------------------------
NODE_ENV=development

# Root domain of the platform. Tenants are served from <subdomain>.<ROOT_DOMAIN>.
# lvh.me resolves to 127.0.0.1, so `site1.lvh.me:3000` works without /etc/hosts.
ROOT_DOMAIN=lvh.me:3000
APP_URL=http://lvh.me:3000

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://webpresslite:webpresslite@127.0.0.1:5432/webpresslite

# --- Storage (S3 compatible, MinIO locally and in production) ----------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=webpresslite-media
S3_ACCESS_KEY_ID=webpresslite
S3_SECRET_ACCESS_KEY=webpresslite
S3_FORCE_PATH_STYLE=true
# Public base URL media is served from (used by next/image).
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:9000/webpresslite-media

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-plus-character-secret

# Optional GitHub OAuth. Either set both or neither.
# Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mail (SMTP via the existing Mailcow server) -----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS on port 465, false for STARTTLS on 587
SMTP_SECURE=false
SMTP_FROM="webpresslite <noreply@example.com>"

# Without SMTP_HOST, mails are written to the log instead of being sent.
# That is fine locally; in production the host is required.
